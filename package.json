{
  "name": "rsckit",
  "version": "0.0.1",
  "description": "Tools for exploring and diagnosing RSCs in Next.js apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js"
  },
  "bin": {
    "rsckit": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pbzona/rsckit.git"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --ignore-watch **/*.test.ts",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "test": "jest",
    "typecheck": "tsc --noEmit --incremental false",
    "rsckit:analyze": "./bin/cli.cjs analyze",
    "rsckit:report": "./bin/cli.cjs report",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "next.js",
    "rsc",
    "react server components"
  ],
  "license": "MIT",
  "author": "Phil Zona <phil.zona@vercel.com>",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/jest": "^30.0.0",
    "@types/jscodeshift": "^0.12.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "react-dom": "^19.3.0",
    "sonda": "^0.7.1",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@devframes/agentic": "1.1.0",
    "@root/walk": "^1.1.0",
    "@swc/core": "^1.16.13",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "dependency-tree": "^11.5.0",
    "detective-typescript": "^14.1.2",
    "devframe": "1.1.0",
    "filing-cabinet": "^5.5.1",
    "globby": "^14.1.0",
    "jscodeshift": "^17.4.0",
    "react": "^19.3.0",
    "tasuku": "^2.3.0",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
